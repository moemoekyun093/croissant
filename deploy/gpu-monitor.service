[Unit]
Description=Remote GPU availability monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gpu-monitor
EnvironmentFile=/etc/gpu-monitor/environment
ExecStart=/usr/bin/python3 /opt/gpu-monitor/gpu_availability_monitor.py --config /etc/gpu-monitor/config.json --once

# Basic service hardening. The state directory remains writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/gpu-monitor

